@using System.Web
@model HugeDockerManager.Models.EditFileModel
@{
    ViewData["Title"] = $"Edit - {ViewBag.FileName}";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-10 col-xl-8 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-edit me-2 text-success"></i>
                    Edit File: <strong>@ViewBag.FileName</strong>
                </h2>
                <div>
                    <span class="badge bg-secondary fs-6 me-2">
                        @Model.Path
                    </span>
                    @if (Model.IsModified)
                    {
                        <span class="badge bg-warning">Unsaved Changes</span>
                    }
                </div>
            </div>

            <form asp-action="Save" method="post">
                <input asp-for="Path" type="hidden" />
                
                <div class="card shadow-sm">
                    <div class="card-header bg-light border-0">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-file-alt text-muted me-2"></i>
                                    <strong>@ViewBag.FileName</strong>
                                    <span class="ms-2 badge @(Model.IsModified ? "bg-warning" : "bg-secondary")">
                                        @if (Model.IsModified) { <text>Modified</text> } else { <text>Saved</text> }
                                    </span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-save me-1"></i>Save
                                    </button>
                                    <a asp-action="Index" 
                                       asp-route-path="@System.IO.Path.GetDirectoryName(Model.Path)"
                                       class="btn btn-outline-secondary">
                                        <i class="fas fa-folder me-1"></i>Back to Folder
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <textarea asp-for="Content" 
                                  class="form-control border-0" 
                                  id="fileContent"
                                  rows="30"
                                  style="font-family: 'Consolas', 'Monaco', monospace; font-size: 14px; resize: vertical;"></textarea>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mt-3">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.addEventListener('beforeunload', function(e) {
            if (@Json.Serialize(Model.IsModified)) {
                e.preventDefault();
            }
        });

        document.getElementById('fileContent').addEventListener('input', function() {
            const saveBtn = document.querySelector('button[type="submit"]');
            const badge = document.querySelector('.badge');
            
            if (this.value !== '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.OriginalContent))') {
                saveBtn.classList.remove('btn-success');
                saveBtn.classList.add('btn-warning');
                saveBtn.innerHTML = '<i class="fas fa-save me-1"></i>Save Changes';
                
                if (badge) {
                    badge.textContent = 'Modified';
                    badge.className = 'badge bg-warning';
                }
            } else {
                saveBtn.classList.remove('btn-warning');
                saveBtn.classList.add('btn-success');
                saveBtn.innerHTML = '<i class="fas fa-save me-1"></i>Save';
                
                if (badge) {
                    badge.textContent = 'Saved';
                    badge.className = 'badge bg-secondary';
                }
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey || e.metaKey) {
                switch(e.key) {
                    case 's':
                        e.preventDefault();
                        document.querySelector('form').submit();
                        break;
                    case 'Enter':
                        if (e.shiftKey) {
                            document.querySelector('form').submit();
                        }
                        break;
                }
            }
        });
    </script>
}